{
  "$schema": "https://opencode.ai/config.json",

  // Главный агент фабрики: DeepSeek V4.1 Flash 1017 с вариантом #max.
  // Четыре специализированных профиля доступны только как его субагенты.
  "default_agent": "factory-lead",
  "model": "opencode-go/deepseek-v4.1-flash",

  // Глобальные границы безопасности для всех агентов фабрики.
  // Секреты не читаются и не редактируются; продуктовые источники правды защищены.
  "permissions": [
    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "secrets/**", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },

    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": ".env.example", "effect": "allow" },
    { "action": "edit", "resource": "**/.env.example", "effect": "allow" },
    { "action": "edit", "resource": "secrets/**", "effect": "deny" },
    { "action": "edit", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "brief.md", "effect": "deny" },
    { "action": "edit", "resource": "PRODUCT.md", "effect": "deny" },

    // Опасные внешние действия требуют явного подтверждения пользователя.
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "gh release*", "effect": "ask" },
    { "action": "shell", "resource": "docker push*", "effect": "ask" },
    { "action": "shell", "resource": "vercel*", "effect": "ask" },
    { "action": "shell", "resource": "netlify*", "effect": "ask" },

    // Обход read-запрета через однострочный Node/PowerShell не нужен агентам.
    { "action": "shell", "resource": "node -e*", "effect": "deny" },
    { "action": "shell", "resource": "node --eval*", "effect": "deny" },
    { "action": "shell", "resource": "node -p*", "effect": "deny" },
    { "action": "shell", "resource": "node --print*", "effect": "deny" }
  ]
}
